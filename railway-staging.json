{
  "$schema": "https://railway.app/railway.schema.json",
  "deploy": {
    "startCommand": "python manage.py migrate --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 2 --access-logfile - --error-logfile - --log-level info",
    "healthcheckPath": "/api/v1/health/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "envs": {
    "DJANGO_SETTINGS_MODULE": {
      "value": "config.settings.staging"
    },
    "RAILWAY_STAGING_DB_URL": {
      "value": "${{Postgres.STAGING_DATABASE_URL}}"
    },
    "SECRET_KEY": {
      "value": "${{RAILWAY_STAGING_SECRET_KEY}}"
    },
    "ALLOWED_HOSTS": {
      "value": "${{RAILWAY_PUBLIC_DOMAIN}},staging.mchvoicecare.org"
    },
    "DEBUG": {
      "value": "False"
    },
    "CSRF_TRUSTED_ORIGINS": {
      "value": "https://${{RAILWAY_PUBLIC_DOMAIN}},https://staging.mchvoicecare.org"
    }
  }
}
