# MCH VoiceCare — Environment Variables Example
#
# Copy this file to .env and adjust values for your local setup.
# The docker-compose.yml uses these defaults automatically.

# ── Database ──
POSTGRES_DB=mchvoicecare
POSTGRES_USER=mch
POSTGRES_PASSWORD=mch_dev_password

# ── Django ──
DJANGO_SETTINGS_MODULE=config.settings.base
DJANGO_DEBUG=True
SECRET_KEY=dev-secret-key-not-for-production

# ── Database URL (used by django-environ) ──
DATABASE_URL=postgres://mch:mch_dev_password@db:5432/mchvoicecare

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── CORS (mobile dev server) ──
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ── JWT ──
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── FCM Push Notifications (spec §22) ──
# Service account JSON from Firebase Console > Project Settings > Service Accounts
# Paste the entire JSON content as a single-line string
#FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── OCR (optional) ──
# OCR_ENGINE=pytesseract
# TESSERACT_CMD=/usr/bin/tesseract

# ── Telephony (optional) ──
# TELEPHONY_GATEWAY_URL=
# TELEPHONY_HMAC_SECRET=

# ── S3 Backups (optional) ──
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Monitoring (spec §27.1) ──
# Bearer token for Prometheus /metrics endpoint. If not set, requires Django admin auth.
#MONITORING_TOKEN=your-monitoring-token-here
