<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (Android 12+) — prevent backup of sensitive
  clinical data (spec §22.2).

  android:allowBackup="false" and android:fullBackupContent="false" in the
  manifest handle older Android versions. This file covers Android 12+
  data extraction / migration scenarios.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
